<Window x:Class="Gomoku.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Gomoku.Models"
        xmlns:domains="clr-namespace:Gomoku.Models.Domain"
        xmlns:conv="clr-namespace:Gomoku.Converter"
        xmlns:local="clr-namespace:Gomoku.Views" xmlns:viewmodels="clr-namespace:Gomoku.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        xmlns:controls="clr-namespace:Gomoku.Controls"
        
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
        Style="{StaticResource MaterialDesignWindow}"
        
        Title="MainWindow" Height="642" Width="834">
    <Window.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBool"/>
        <conv:BoolToHiddenConverter x:Key="BoolToVisibility"/>
        <BooleanToVisibilityConverter x:Key="BoolToCollapseVis"/>
        <conv:EqualToVisibilityConverter x:Key="EqualToVis"/>
        <Style x:Key="PlayerInfoPanelStyle" TargetType="StackPanel">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,5,0,5"/>
            <Setter Property="Orientation" Value="Horizontal"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="LightGray"/>
                </Trigger>

            </Style.Triggers>
        </Style>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="MainDialogHost">
        <DockPanel>
            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Menu DockPanel.Dock="Top" Grid.Column="0">
                    <MenuItem Header="연결" Command="{Binding OpenConnectWindowCommand}"/>
                    <MenuItem Header="정보" Command="{Binding OpenInformationWindowCommand}"/>
                    <MenuItem Header="게임">
                        <MenuItem Header="최근 전적 보기(WIP)"/>
                        <MenuItem Header="랭킹 보기" Command="{Binding OpenRankingWindowCommand}"/>
                        <MenuItem Header="{Binding Session.Me.LeftCancelLast}" HeaderStringFormat="무르기 {0}회 남음"
                            Command="{Binding CancelLastStoneCommand}"
                            Visibility="{Binding Session.CanCancelLast, Converter={StaticResource BoolToCollapseVis}}"/>
                    </MenuItem>
                </Menu>
                <!-- 게임 시작 버튼 -->
                <Button x:Name="ButtonGameStart" Content="게임 시작" Grid.Column="1" Margin="0,0,4,0" Padding="6,0,6,0"
                        Command="{Binding GameStartCommand}">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0">
                                <materialDesign:PackIcon Kind="PlayCircleOutline" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Session.CanShowStartButton}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- 바둑판 -->
                    <ColumnDefinition Width="230"/>
                    <!-- 플레이어 정보 및 채팅 -->
                </Grid.ColumnDefinitions>


                <!-- 바둑판 -->
                <Grid DataContext="{Binding Board}">
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding BoardCells}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- 15x15 격자 -->
                                <UniformGrid Columns="15" Rows="15" Background="SandyBrown"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.PlaceStoneCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource GomokuCellStyle}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <Grid Grid.Column="1" Margin="10,0,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 흑 정보 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 백 정보 -->
                        <RowDefinition Height="1*"/>
                        <!-- 참여자 목록 -->
                        <RowDefinition Height="2*"/>
                        <!-- 채팅 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 메시지 입력 -->
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Vertical" >
                        <!-- 흑 정보 -->
                        <controls:PlayerCard Player="{Binding Session.BlackPlayer}" TeamType="Black"
                                             Me="{Binding Session.Me}"
                                             JoinGameCommand="{Binding JoinGameCommand}"
                                             LeaveGameCommand="{Binding LeaveGameCommand}"
                                             Margin="0,0,0,3"/>
                        <controls:PlayerCard Player="{Binding Session.WhitePlayer}" TeamType="White"
                                             Me="{Binding Session.Me}"
                                             JoinGameCommand="{Binding JoinGameCommand}"
                                             LeaveGameCommand="{Binding LeaveGameCommand}"/>
                    </StackPanel>
                    <!-- 유저 리스트 -->
                    <materialDesign:Card Grid.Row="2" Margin="0,4,0,4">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Session.UserList}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" Margin="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <materialDesign:Chip Content="{Binding Nickname}">
                                            <!-- 전적 툴팁 -->
                                            <materialDesign:Chip.ToolTip>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock>
                                                        <Run Text="{Binding Win}"/>
                                                        <Run Text="승"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="2,0">
                                                        <Run Text="{Binding Loss}"/>
                                                        <Run Text="패"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="2,0">
                                                        <Run Text="{Binding Draw}"/>
                                                        <Run Text="무"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </materialDesign:Chip.ToolTip>
                                        <materialDesign:Chip.Icon>
                                                <ContentControl Content="{Binding}">
                                                    <ContentControl.ContentTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <!-- 기본 아이콘 -->
                                                                <materialDesign:PackIcon x:Name="DefaultIcon" Kind="Account"/>
                                                                <!-- 흑 또는 백이면 돌 모양 아이콘 -->
                                                                <Ellipse x:Name="StoneIcon" Width="16" Height="16"/>
                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static domains:PlayerType.Black}">
                                                                    <Setter TargetName="DefaultIcon" Property="Visibility" Value="Collapsed"/>
                                                                    <Setter TargetName="StoneIcon" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="StoneIcon" Property="Fill" Value="Black"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static domains:PlayerType.White}">
                                                                    <Setter TargetName="DefaultIcon" Property="Visibility" Value="Collapsed"/>
                                                                    <Setter TargetName="StoneIcon" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="StoneIcon" Property="Fill" Value="White"/>
                                                                    <Setter TargetName="StoneIcon" Property="Stroke" Value="Black"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ContentControl.ContentTemplate>
                                                </ContentControl>
                                            </materialDesign:Chip.Icon>
                                        </materialDesign:Chip>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </materialDesign:Card>
                    <!-- 채팅 메시지 -->
                    <materialDesign:Card Grid.Row="3" Margin="0,0,0,4">
                        <ListBox x:Name="ChatListBox" ItemsSource="{Binding ChatMessages}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         HorizontalAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- 채팅 영역 텍스트 자동 줄바꿈 -->
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </materialDesign:Card>
                    <!-- 채팅 메시지 입력 -->
                    <Grid Grid.Row="4" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}">
                            <!-- 채팅 입력 텍스트박스 -->
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendChatCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <!-- 전송 버튼 -->
                        <Button Content="전송" FontSize="11" Grid.Column="1" Padding="0" 
                            Command="{Binding SendChatCommand}" Width="50"/>
                    </Grid>

                </Grid>
                <materialDesign:Snackbar VerticalAlignment="Bottom" MessageQueue="{Binding MainSnackBarQueue}"/>
            </Grid>

        </DockPanel>

    </materialDesign:DialogHost>
</Window>
